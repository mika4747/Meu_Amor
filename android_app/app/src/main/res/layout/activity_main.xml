<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primaria"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPagina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#F8D7E4"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Abas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primaria"
        android:orientation="horizontal">

        <Button
            android:id="@+id/abaPostar"
            style="@style/Aba"
            android:text="Postar" />

        <Button
            android:id="@+id/abaAgenda"
            style="@style/Aba"
            android:text="Horários" />

        <Button
            android:id="@+id/abaConta"
            style="@style/Aba"
            android:text="Conta" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/rolagem"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- ============================== POSTAR ============================== -->
            <LinearLayout
                android:id="@+id/painelPostar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Titulo"
                    android:text="Foto, fotos ou Reel" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnFotos"
                        style="@style/BotaoSecundario"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="📷 Fotos" />

                    <Button
                        android:id="@+id/btnReel"
                        style="@style/BotaoSecundario"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="🎬 Reel" />

                    <Button
                        android:id="@+id/btnLimparMidia"
                        style="@style/BotaoSecundario"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="✕" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtMidia"
                    style="@style/Ajuda" />

                <TextView
                    style="@style/Titulo"
                    android:text="Legenda" />

                <EditText
                    android:id="@+id/edtLegenda"
                    style="@style/Campo"
                    android:gravity="top"
                    android:hint="Escreva a legenda do post..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />

                <EditText
                    android:id="@+id/edtHashtagsPost"
                    style="@style/Campo"
                    android:hint="Hashtags deste post (ex.: #amor #viagem)"
                    android:inputType="text" />

                <TextView
                    style="@style/Titulo"
                    android:text="Quando publicar" />

                <RadioGroup
                    android:id="@+id/rgQuando"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbProximo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="No próximo horário livre" />

                    <RadioButton
                        android:id="@+id/rbEscolher"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Escolher dia e hora" />

                    <RadioButton
                        android:id="@+id/rbAgora"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Agora" />
                </RadioGroup>

                <TextView
                    android:id="@+id/txtQuando"
                    style="@style/Ajuda"
                    android:textColor="@color/primaria"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Titulo"
                    android:text="Prévia da legenda" />

                <TextView
                    android:id="@+id/txtPrevia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/caixa"
                    android:padding="12dp"
                    android:textColor="@color/texto"
                    android:textIsSelectable="true" />

                <Button
                    android:id="@+id/btnEnviar"
                    style="@style/BotaoPrincipal"
                    android:layout_marginTop="20dp"
                    android:text="Agendar" />

                <ProgressBar
                    android:id="@+id/progresso"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtResultado"
                    style="@style/Ajuda"
                    android:textIsSelectable="true" />

                <Button
                    android:id="@+id/btnStatusReel"
                    style="@style/BotaoSecundario"
                    android:layout_width="match_parent"
                    android:text="Ver se o Reel já foi processado"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ============================== HORÁRIOS ============================== -->
            <LinearLayout
                android:id="@+id/painelAgenda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Titulo"
                    android:text="Horários de postagem" />

                <EditText
                    android:id="@+id/edtHorarios"
                    style="@style/Campo"
                    android:hint="09:00, 12:30, 19:00"
                    android:inputType="text" />

                <TextView
                    style="@style/Ajuda"
                    android:text="Separe por vírgula. Os posts vão para o próximo desses horários que estiver livre." />

                <TextView
                    style="@style/Titulo"
                    android:text="Dias da semana" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <CheckBox android:id="@+id/dia1" style="@style/Dia" android:text="Seg" />
                    <CheckBox android:id="@+id/dia2" style="@style/Dia" android:text="Ter" />
                    <CheckBox android:id="@+id/dia3" style="@style/Dia" android:text="Qua" />
                    <CheckBox android:id="@+id/dia4" style="@style/Dia" android:text="Qui" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <CheckBox android:id="@+id/dia5" style="@style/Dia" android:text="Sex" />
                    <CheckBox android:id="@+id/dia6" style="@style/Dia" android:text="Sáb" />
                    <CheckBox android:id="@+id/dia7" style="@style/Dia" android:text="Dom" />
                    <Space style="@style/Dia" />
                </LinearLayout>

                <TextView
                    style="@style/Titulo"
                    android:text="Hashtags em todos os posts" />

                <EditText
                    android:id="@+id/edtHashtagsPadrao"
                    style="@style/Campo"
                    android:hint="#meuamor #amor"
                    android:inputType="text" />

                <TextView
                    style="@style/Titulo"
                    android:text="Assinatura (fim de toda legenda)" />

                <EditText
                    android:id="@+id/edtAssinatura"
                    style="@style/Campo"
                    android:hint="💛 Siga a página para mais!"
                    android:inputType="textMultiLine|textCapSentences" />

                <Button
                    android:id="@+id/btnSalvarAgenda"
                    style="@style/BotaoPrincipal"
                    android:layout_marginTop="16dp"
                    android:text="Salvar" />

                <TextView
                    android:id="@+id/txtProximos"
                    style="@style/Ajuda" />

                <TextView
                    style="@style/Titulo"
                    android:layout_marginTop="24dp"
                    android:text="Posts enviados por este app" />

                <TextView
                    android:id="@+id/txtHistorico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/caixa"
                    android:padding="12dp"
                    android:textColor="@color/texto"
                    android:textIsSelectable="true" />

                <Button
                    android:id="@+id/btnLimparHistorico"
                    style="@style/BotaoSecundario"
                    android:layout_width="match_parent"
                    android:text="Limpar histórico" />

                <TextView
                    style="@style/Ajuda"
                    android:text="Para editar ou cancelar um post agendado, use o Meta Business Suite → Planejador." />
            </LinearLayout>

            <!-- ============================== CONTA ============================== -->
            <LinearLayout
                android:id="@+id/painelConta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtContaStatus"
                    style="@style/Titulo" />

                <TextView
                    style="@style/Ajuda"
                    android:text="@string/ajuda_conectar" />

                <Button
                    android:id="@+id/btnAbrirApps"
                    style="@style/BotaoSecundario"
                    android:layout_width="match_parent"
                    android:text="1. Abrir meus apps da Meta" />

                <Button
                    android:id="@+id/btnAbrirExplorer"
                    style="@style/BotaoSecundario"
                    android:layout_width="match_parent"
                    android:text="2. Abrir o Graph API Explorer" />

                <TextView
                    style="@style/Titulo"
                    android:text="3. Cole os dados aqui" />

                <EditText
                    android:id="@+id/edtAppId"
                    style="@style/Campo"
                    android:hint="ID do app (App ID)"
                    android:inputType="number" />

                <EditText
                    android:id="@+id/edtAppSecret"
                    style="@style/Campo"
                    android:hint="Chave secreta do app (App Secret)"
                    android:inputType="textPassword" />

                <EditText
                    android:id="@+id/edtToken"
                    style="@style/Campo"
                    android:hint="Token do Graph API Explorer (EAA...)"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/btnConectar"
                    style="@style/BotaoPrincipal"
                    android:layout_marginTop="16dp"
                    android:text="Conectar" />

                <TextView
                    android:id="@+id/txtContaResultado"
                    style="@style/Ajuda"
                    android:textIsSelectable="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnVerificar"
                        style="@style/BotaoSecundario"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Testar conexão" />

                    <Button
                        android:id="@+id/btnDesconectar"
                        style="@style/BotaoSecundario"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Desconectar" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
