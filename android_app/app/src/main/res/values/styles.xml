<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primaria</item>
        <item name="android:colorPrimaryDark">@color/primaria_escura</item>
        <item name="android:colorAccent">@color/primaria</item>
        <item name="android:statusBarColor">@color/primaria_escura</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:textColorPrimary">@color/texto</item>
    </style>

    <style name="Aba">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Titulo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Ajuda">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/caixa</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">#A8939C</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="BotaoPrincipal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:backgroundTint">@color/primaria</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BotaoSecundario">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/icone_fundo</item>
        <item name="android:textColor">@color/primaria_escura</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Dia">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>
</resources>
