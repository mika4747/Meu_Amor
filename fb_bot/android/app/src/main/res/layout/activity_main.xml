<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===================== CONFIGURAÇÃO ===================== -->
        <LinearLayout
            android:id="@+id/setupSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Conectar ao Facebook"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Informe os dados do seu app do Facebook (developers.facebook.com → seu app → Configurações → Básico). Você só faz isso uma vez." />

            <EditText
                android:id="@+id/appIdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="App ID"
                android:inputType="number" />

            <EditText
                android:id="@+id/appSecretInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="App Secret (para a conexão não expirar)"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/configIdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Config ID (só se o app for do tipo Empresa)"
                android:inputType="number" />

            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/brand"
                android:text="Entrar com Facebook"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/helpLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="8dp"
                android:text="❓ Como criar o app do Facebook (passo a passo)"
                android:textColor="@color/brand" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Avançado: colar um token manualmente"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/tokenInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Token de acesso (Graph API Explorer)"
                android:inputType="textNoSuggestions|textMultiLine"
                android:maxLines="4" />

            <Button
                android:id="@+id/connectButton"
                style="@android:style/Widget.Material.Button.Borderless.Colored"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Conectar com token" />
        </LinearLayout>

        <!-- ===================== PRINCIPAL ===================== -->
        <LinearLayout
            android:id="@+id/mainSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Página" />

            <Spinner
                android:id="@+id/pageSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="🎬 Novo Reel"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/pickVideoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Escolher vídeo" />

            <TextView
                android:id="@+id/videoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nenhum vídeo escolhido (vertical, 3 a 90 s)"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/captionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="top"
                android:hint="Legenda… #hashtags"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/scheduleCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agendar" />

                <TextView
                    android:id="@+id/scheduleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/publishButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Publicar Reel" />

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="✍️ Post de texto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/postInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="No que você está pensando?"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3" />

            <EditText
                android:id="@+id/linkInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Link (opcional)"
                android:inputType="textUri" />

            <Button
                android:id="@+id/postButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Publicar post" />

            <Button
                android:id="@+id/logoutButton"
                style="@android:style/Widget.Material.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Trocar conta / token" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
