# Copie este arquivo para .env e preencha. NUNCA envie o .env para o GitHub.

# Token de usuário com as permissões:
#   pages_show_list, pages_read_engagement, pages_manage_posts,
#   pages_manage_engagement (para responder/ocultar comentários)
FB_USER_TOKEN=

# Dados do seu app em developers.facebook.com (para gerar token de longa duração)
FB_APP_ID=
FB_APP_SECRET=

# Página padrão (veja os IDs com: python -m fbbot pages)
FB_PAGE_ID=

FB_API_VERSION=v23.0
FB_QUEUE_DIR=fila
FB_QUEUE_INTERVAL_MINUTES=240
